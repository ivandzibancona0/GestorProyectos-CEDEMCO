# ========================================================
# CEDEMCO - UADY: .gitignore
# ========================================================

# Dependencias
node_modules/
.pnp
.pnp.js

# Variables de entorno y credenciales (mantener siempre privado)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
!.env.example

# Logs y depuración
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Pruebas y cobertura
coverage/
.nyc_output/

# Archivos temporales y caché
tmp/
temp/
*.tmp
*.temp
.cache/

# Respaldos y volcados de base de datos
*.dump
*.backup
*.sql.gz

# Docker: overrides locales de desarrollo
compose.override.yaml
compose.override.yml
docker-compose.override.yml

# Archivos del sistema operativo
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editores e IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
